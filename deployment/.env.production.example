# =============================================================================
# .env — Production Configuration Example
# انسخ هذا الملف إلى .env على السيرفر وعدّل القيم
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Restaurant SaaS"
APP_ENV=production
APP_KEY=                          # سيُولَّد بـ: php artisan key:generate
APP_DEBUG=false                   # مهم: false في الإنتاج دائماً
APP_URL=https://yourdomain.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurant_saas
DB_USERNAME=restaurant_user
DB_PASSWORD=STRONG_PASSWORD_HERE
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ── Cache & Session ───────────────────────────────────────────────────────────
# في الإنتاج: Redis أفضل بكثير من database للـ Cache والـ Session
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true        # مهم مع HTTPS

# ── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis            # أو database إذا لم يكن Redis متاحاً

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org         # أو sendgrid, ses, postmark
MAIL_PORT=587
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=MAIL_PASSWORD_HERE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Filesystem ────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=public            # الصور محلياً — غيّر إلى s3 للسحابة

# (اختياري) Amazon S3 للملفات
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=error                   # error في الإنتاج — لا debug
LOG_DEPRECATIONS_CHANNEL=null

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12                  # 10-12 مناسب للإنتاج

# ── Performance ───────────────────────────────────────────────────────────────
OCTANE_SERVER=swoole              # اختياري — لتحسين الأداء مع Laravel Octane
