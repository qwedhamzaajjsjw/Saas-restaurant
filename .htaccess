# ============================================================
#  ROOT .htaccess – Shared Hosting (Hostinger / cPanel)
#  Transparently routes all web traffic to the /public folder
#  AND blocks direct access to all sensitive files/folders.
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── Route to public/ (internal rewrite, URL stays clean) ────────────────
    # Serve files/directories that physically exist inside public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Everything else → Laravel front controller
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>

# ── Block direct access to sensitive files ────────────────────────────────────
<FilesMatch "(?i)(^\.env|\.env\..+|composer\.(json|lock)|artisan|phpunit\.xml|\.setup_token|package(-lock)?\.json|webpack\.mix\.js|vite\.config\.js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── Block direct access to sensitive directories ──────────────────────────────
<IfModule mod_rewrite.c>
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L]
</IfModule>

# ── Deny directory listing everywhere ─────────────────────────────────────────
Options -Indexes
